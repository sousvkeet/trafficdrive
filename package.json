{
  "name": "trafficdrive",
  "version": "5.11.2",
  "description": "TrafficDrive - Desktop Traffic Automation Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install-browsers": "playwright install chromium",
    "mcp": "node mcp-server.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --win --x64 --dir --publish never",
    "smoke": "node scripts/smoke-packaged.js"
  },
  "author": "TrafficDrive",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "extract-zip": "^2.0.1",
    "playwright": "^1.63.0",
    "socks": "^2.8.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.18.1"
  },
  "bin": {
    "trafficdrive-mcp": "mcp-server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sousvkeet/trafficdrive.git"
  },
  "build": {
    "appId": "com.trafficdrive.app",
    "productName": "TrafficDrive",
    "copyright": "Copyright © TrafficDrive",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "**/*",
      "!dist/**",
      "!scripts/**",
      "!.github/**",
      "!README.md",
      "!.gitignore"
    ],
    "win": {
      "icon": "logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TrafficDrive-Setup-${version}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "artifactName": "TrafficDrive-${version}-x64.${ext}"
    }
  }
}
